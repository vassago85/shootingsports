{
  "expo": {
    "name": "Shooting Sports",
    "slug": "shootingsports",
    "scheme": "shootingsports",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0E3328"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.shootingsports.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shootingsports.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E3328"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC-DIVqHR_xs8DZugLa2slGfUv--itlCIg"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a3f6c97d-97b4-48df-880d-e13fd30c741a"
      },
      "router": {}
    },
    "owner": "charsley-digital",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a3f6c97d-97b4-48df-880d-e13fd30c741a"
    }
  }
}
