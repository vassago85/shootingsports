{
  "expo": {
    "name": "Shooting Sports",
    "slug": "shootingsports",
    "scheme": "shootingsports",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "com.shootingsports.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shootingsports.app",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "a3f6c97d-97b4-48df-880d-e13fd30c741a"
      },
      "router": {}
    },
    "owner": "charsley-digital",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a3f6c97d-97b4-48df-880d-e13fd30c741a"
    }
  }
}
