.git
.env
.env.*
node_modules
vendor
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/media
database/database.sqlite
tests
.phpunit.cache
agent-transcripts

# Mobile / Expo workspace. The runtime PHP-FPM image doesn't need the React
# Native source — the Dockerfile's `pwa` stage exports a static web bundle
# into public/app/ and the `rm -rf apps` step in the runtime stage drops the
# source. But the pwa stage itself needs apps/mobile/ in the build context,
# so we only ignore the heavy regeneratable subdirectories.
apps/mobile/node_modules
apps/mobile/dist
apps/mobile/.expo
apps/mobile/expo-start.err
apps/mobile/*.log
# Local dotenv files carry dev-only values (Laragon LAN IPs, dev secrets).
# Expo's dotenv loader reads these before shell env, so if we let one into
# the Docker build context the `pwa` stage bakes a shooter's LAN IP (or
# worse) into the production bundle. Keep these out; the Dockerfile sets
# the production EXPO_PUBLIC_* values explicitly.
apps/mobile/.env
apps/mobile/.env.*
!apps/mobile/.env.example
# Anything else in apps/ (future workspaces) stays out of the image until it
# has its own build stage.
apps/*/node_modules
apps/*/dist
apps/*/.expo
