APP_NAME="Shooting Sports"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://shootingsports.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_TIMEZONE=Africa/Johannesburg

APP_MAINTENANCE_DRIVER=file

# When true, every public/web request is intercepted and shown a
# branded "coming soon" landing page. Staff and match directors can
# still log in and browse the real site so the team can keep
# building. Filament panels (/admin, /desk) are always reachable.
COMING_SOON=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local Laragon can stay on sqlite. Production / docker-compose uses pgsql.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=55434
# DB_DATABASE=shootingsports
# DB_USERNAME=shootingsports
# DB_PASSWORD=shootingsports

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=media
# On the server, bind-mount the 4TB volume here:
MEDIA_ROOT=
MEDIA_HOST_PATH=/mnt/storage/shootingsports/media
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@shootingsports.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Production (Mailgun). Switch MAIL_MAILER=mailgun when credentials are in.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Search Console — the primary handshake is the static verification
# file in public/. Set this only if you want the meta-tag fallback too.
GOOGLE_SITE_VERIFICATION=

# Shared Umami analytics. Point script URL at the tracker JS on your
# Umami instance (e.g. https://analytics.charsley.co.za/script.js) and
# set the website id from the Umami dashboard for shootingsports.co.za.
# Leave blank locally to keep pages tracker-free.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Optional CARTO basemap key for /map (Positron tiles). Without it the
# map falls back to free OSM tiles with a CSS mute — CARTO watermarks
# "API KEY REQUIRED" when the key is missing. Set on the server once
# the account is approved: https://carto.com/basemaps/apikey
CARTO_API_KEY=

# Paystack subscriptions. Grab keys from https://dashboard.paystack.com/
# → Settings → API Keys & Webhooks. Test keys (pk_test_ / sk_test_) hit
# the sandbox only and can safely stay in local .env. Live keys go on
# the server only.
#
# Plan codes: run `php artisan paystack:setup-plans` once to create the
# two plans (R299/year, R29/month) idempotently against the Paystack
# account whose secret key is loaded, then paste the returned PLN_...
# codes back into these vars.
#
# Webhook URL to configure in the Paystack dashboard:
#   https://shootingsports.co.za/paystack/webhook
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=ZAR
PAYSTACK_PLAN_ANNUAL=
PAYSTACK_PLAN_MONTHLY=
