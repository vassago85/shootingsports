APP_NAME="Shooting Sports"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://shootingsports.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_TIMEZONE=Africa/Johannesburg

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local Laragon can stay on sqlite. Production / docker-compose uses pgsql.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=55434
# DB_DATABASE=shootingsports
# DB_USERNAME=shootingsports
# DB_PASSWORD=shootingsports

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=media
# On the server, bind-mount the 4TB volume here:
MEDIA_ROOT=
MEDIA_HOST_PATH=/mnt/storage/shootingsports/media
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@shootingsports.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Production (Mailgun). Switch MAIL_MAILER=mailgun when credentials are in.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
